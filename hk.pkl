amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Builtins.pkl"

min_hk_version = "1.54.0"

exclude = List("node_modules", "dist", ".astro")

local slow_checks = new Mapping<String, Step> {
    ["typecheck"] {
        check = "mise run typecheck"
    }
    ["test"] {
        check = "mise run test"
    }
    ["ctxharness"] {
        check = "ctxharness run --no-trend"
    }
}

local linters = new Mapping<String, Step> {
    ["biome"] = (Builtins.biome) {
        glob = List("**/*.js", "**/*.mjs", "**/*.ts", "**/*.tsx", "**/*.astro", "**/*.css", "**/*.json", "**/*.svg")
        batch = true
    }
    ["actionlint"] = Builtins.actionlint
    ["aislop"] {
        check = "aislop ci --staged"
    }
    ["markdownlint"] {
        glob = List("**/*.md")
        // Excludes files that predate (or deliberately violate) the tuned
        // .markdownlint-cli2.jsonc — long one-line directives, tables that resist
        // auto-alignment, sigmap-generated HTML. Keep all other markdown linted.
        exclude = List(
            "**/skills/**",
            ".claude/worktrees/**",
            "AGENTS.md",
            "CLAUDE.md",
            ".agents/RULES.md",
            ".agents/instructions/aislop.md",
            ".agents/instructions/skill-authoring.md",
            ".agents/instructions/theme-vocabulary.md"
        )
        check = "markdownlint-cli2 {{files}}"
        fix = "markdownlint-cli2 --fix {{files}}"
    }
    ["trailing-whitespace"] = Builtins.trailing_whitespace
    ["end-of-file-fixer"] = Builtins.newlines
    ["check-merge-conflict"] = Builtins.check_merge_conflict
    ["check-added-large-files"] = Builtins.check_added_large_files
    ["check-case-conflict"] = Builtins.check_case_conflict
    ["detect-private-key"] = Builtins.detect_private_key
    ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
    ["mixed-line-ending"] = Builtins.mixed_line_ending
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = slow_checks
    }
    ["post-commit"] {
        // qmd-update indexes committed content into a local search DB and writes no
        // tracked files, so post-commit is the right place for it.
        steps {
            ["qmd-update"] {
                check = "qmd update"
            }
            ["qmd-embed-thoroc"] {
                // `qmd update` only refreshes the BM25 keyword index; vec/hyde semantic
                // search needs embeddings, which it does not touch. Embed the repo's
                // agent docs after indexing so newly committed skills/instructions are
                // semantically searchable. Gated on the .agents/ glob so it fires only
                // when an instruction/skill changed, not on every commit. `depends` also
                // serialises against qmd-update so the two never contend on the SQLite DB.
                glob = List(".agents/**/*.md")
                check = "qmd embed -c thoroc"
                depends = List("qmd-update")
            }
        }
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
