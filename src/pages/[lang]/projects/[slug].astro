---
import { getCollection, render } from 'astro:content'
import { type Lang, useTranslations } from '../../../i18n/ui'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { projects, projectTagline } from '../../../lib/projects'

export async function getStaticPaths() {
  const deepDives = await getCollection('projects')
  const paths = []
  for (const lang of ['en', 'fr'] as const) {
    for (const p of projects) {
      if (deepDives.some((d) => d.id === `${lang}/${p.slug}`)) {
        paths.push({
          params: { lang, slug: p.slug },
          props: { lang, project: p },
        })
      }
    }
  }
  return paths
}

const { lang, project } = Astro.props
const t = useTranslations(lang as Lang)

const deepDive = (await getCollection('projects')).find(
  (d) => d.id === `${lang}/${project.slug}`,
)
const { Content } = await render(deepDive!)
const title = deepDive?.data.title ?? project.name
---

<BaseLayout lang={lang as Lang} title={title}>
  <article class="project-page">
    <a class="back-link" href={`/${lang}/`}>← {t('nav.home')}</a>
    <header class="project-header">
      <h1>{title}</h1>
      <p class="card-tagline">{projectTagline(project, lang as 'en' | 'fr')}</p>
      <ul class="card-tags">
        {project.tags.map((tag) => <li class="card-tag">{tag}</li>)}
      </ul>
      <div class="card-links">
        {project.github && <a class="card-link" href={project.github} rel="noopener">{t('card.source')}</a>}
        {project.demo && <a class="card-link" href={project.demo} rel="noopener">{t('card.demo')}</a>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
