---
import { useTranslations, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang, title } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t('site.title');
const fullTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="site-title" href={`/${lang}/`}>thoroc</a>
        <nav class="site-nav">
          <a href={`/${lang}/`}>{t('nav.home')}</a>
          <a href={`/${lang}/#projects`}>{t('nav.projects')}</a>
        </nav>
        <a class="lang-switch" href={lang === 'en' ? '/fr/' : '/en/'}>
          {lang === 'en' ? 'Français' : 'English'}
        </a>
      </header>

      <main><slot /></main>

      <footer class="site-footer">
        <span>{t('footer.tagline')}</span>
      </footer>
    </div>
  </body>
</html>
