---
import { type Lang, useTranslations } from '../i18n/ui'
import '../styles/global.css'
import SiteHeader from '../components/ui/SiteHeader.astro'

interface Props {
  lang: Lang
  title?: string
}

const { lang, title } = Astro.props
const t = useTranslations(lang)
const fullTitle = title ? `${title} — ${t('site.title')}` : t('site.title')
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,900&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      (function () {
        try {
          var stored =
            localStorage.getItem('color-theme') ||
            localStorage.getItem('stars-color-theme')
          var dark =
            stored === 'dark' ||
            (stored !== 'light' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)
          document.documentElement.dataset.theme = dark ? 'dark' : 'light'
        } catch (e) {}
      })()
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="shell">
      <SiteHeader lang={lang} />

      <main><slot /></main>

      <footer class="site-footer">
        <span>{t('footer.tagline')}</span>
      </footer>
    </div>
  </body>
</html>
