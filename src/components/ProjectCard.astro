---
import { type Lang, useTranslations } from '../i18n/ui'
import type { Project } from '../lib/projects'
import { projectTagline } from '../lib/projects'
import Badge from './ui/Badge.astro'
import Button from './ui/Button.astro'

interface Props {
  project: Project
  lang: Lang
  hasDeepDive: boolean
}

const { project, lang } = Astro.props
const t = useTranslations(lang)
const tagline = projectTagline(project, lang)
const detailHref = `/${lang}/projects/${project.slug}/`
---

<article class={`card${project.featured ? ' card--featured' : ''}`}>
  <div class="card-head">
    <h3 class="card-name">{project.name}</h3>
    {project.year && <span class="card-year">{project.year}</span>}
  </div>
  <p class="card-tagline">{tagline}</p>
  <ul class="card-tags">
    {project.tags.map((tag) => <li><Badge>{tag}</Badge></li>)}
  </ul>
  <div class="card-links">
    {Astro.props.hasDeepDive && (
      <Button href={detailHref} variant="ghost">{t('card.readMore')}</Button>
    )}
    {project.github && (
      <Button href={project.github} rel="noopener" variant="ghost">{t('card.source')}</Button>
    )}
    {project.demo && (
      <Button href={project.demo} rel="noopener" variant="ghost">{t('card.demo')}</Button>
    )}
  </div>
</article>
