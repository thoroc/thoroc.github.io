<span class="badge"><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--accent-3);
    /* Fixed dark navy, not var(--fg): --accent-3 (mustard) stays a light
       colour in both themes, so the text needs to stay dark regardless of
       page theme -- var(--fg) flips to a light cream in dark mode, which
       measured 1.33:1 against dark-mode --accent-3 (WCAG AA needs 4.5:1). */
    color: #1b3a4b;
  }
</style>
